# Image tags are pinned to specific releases on purpose: no floating `latest`.
# Bump `imageTag` here (or override with IMAGE_TAG) to roll out a new version.
environments:
  default:
    values:
      - releaseName: hutbot
        namespace: mw-internal
        imageTag: v1.0.9
        slashCommand: /hutbot
        botName: Hutbot
        # Timezone and date/time locale of the instance; set them in the env file
        # (HUTBOT_TIMEZONE / HUTBOT_DEFAULT_DATETIME_LOCALE). Empty means the
        # image default: UTC and English day/month names.
        timezone: ""
        datetimeLocale: ""
  dev:
    values:
      - releaseName: hutbot-dev
        namespace: mw-internal
        imageTag: v1.0.9
        # The dev instance runs behind its own Slack app, which registers its own
        # slash command. Must match the command configured there.
        slashCommand: /hutbot_dev
        botName: Hutbot (DEV)
        timezone: ""
        datetimeLocale: ""
---
repositories: []

releases:
  - name: {{ .Values.releaseName }}
    namespace: {{ env "NAMESPACE" | default .Values.namespace }}
    chart: ./charts/hutbot
    values:
      - image:
          repository: {{ env "IMAGE_REPOSITORY" | default "ghcr.io/mittwald/hutbot" | quote }}
          tag: {{ env "IMAGE_TAG" | default .Values.imageTag | quote }}
        replicaCount: 1
      # Every credential comes from the Kubernetes Secret synced by scripts/sync-secret.sh
      # before deploying, so no secret value enters Helm values or the release metadata
      # Helm stores in the cluster. Nothing in this file is a `requiredEnv` any more, which
      # is what lets `helmfile diff` run in a shell that has never seen a token.
      - existingSecret: {{ env "HUTBOT_EXISTING_SECRET" | default .Values.releaseName | quote }}
      - slack:
          slashCommand: {{ env "HUTBOT_SLASH_COMMAND" | default .Values.slashCommand | quote }}
          botName: {{ env "HUTBOT_BOT_NAME" | default .Values.botName | quote }}
      - time:
          timezone: {{ env "HUTBOT_TIMEZONE" | default .Values.timezone | quote }}
          locale: {{ env "HUTBOT_DEFAULT_DATETIME_LOCALE" | default .Values.datetimeLocale | quote }}
      - persistence:
          enabled: {{ env "PERSISTENCE_ENABLED" | default "true" | quote }}
          accessModes:
            - ReadWriteOnce
          size: {{ env "PERSISTENCE_SIZE" | default "100Mi" | quote }}
          storageClass: {{ env "PERSISTENCE_STORAGE_CLASS" | default "" | quote }}
          mountPath: {{ env "PERSISTENCE_MOUNT_PATH" | default "/data" | quote }}
{{- if env "NETWORKPOLICY_RULES" }}
      - networkPolicy:
          rules:
{{- range $pair := splitList " " (env "NETWORKPOLICY_RULES") }}
{{- $parts := splitList ":" $pair }}
            - port: {{ index $parts 0 }}
              cidrs:
{{- range $cidr := splitList "," (index $parts 1) }}
                - {{ $cidr }}
{{- end }}
{{- end }}
{{- end }}

{{- if env "HOST_ALIASES" }}
      - hostAliases:
{{- range $pair := splitList "," (env "HOST_ALIASES") }}
{{- $parts := splitList "=" $pair }}
            - ip: {{ index $parts 1 | quote }}
              hostnames:
                - {{ index $parts 0 | quote }}
{{- end }}
{{- end }}
